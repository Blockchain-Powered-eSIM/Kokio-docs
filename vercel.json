{
  "functions": {
    "api/ask.mjs": {
      "includeFiles": "static/llms-full.txt",
      "maxDuration": 20
    }
  },
  "redirects": [
    {
      "source": "/docs/contracts/deployments",
      "destination": "/docs/deployments/base",
      "permanent": true
    },
    {
      "source": "/md/contracts/deployments.md",
      "destination": "/md/deployments/base.md",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/md/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
